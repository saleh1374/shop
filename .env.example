# کپی از این فایل بساز: cp .env.example .env
# دیتابیس PostgreSQL خودت را تنظیم کن
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# رمز امضای نشست کاربران (یک رشته طولانی و تصادفی)
# openssl rand -base64 48
AUTH_SECRET=""

# اختیاری: درگاه پرداخت زرین‌پال (بعداً فعال می‌شود)
ZARINPAL_MERCHANT_ID=""

# اختیاری: تنظیمات SMTP برای ارسال ایمیل
# اگر تنظیم نشود، ایمیل‌ها ارسال نمی‌شوند
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app-password"

# آدرس سایت (برای نقشه سایت و لینک‌ها)
# STORE_URL="https://your-domain.com"

# اختیاری: ورود با گوگل
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
